type Query {
    getDocument(id: ID!): Document

    listDocuments(page: Int!, size:Int!): DocumentPage!
}

type Mutation {
    acquireDocuments: Boolean!
    startWorkflows: Boolean!
    approveDocument(id: ID!): Boolean!
}

type Document {
    id: ID!
    filename: String!
    approved: Boolean!
}

type DocumentPage {
    items: [Document]
}
